[MASTER]
load-plugins = pylint_django
init-hook = import sys, os; sys.path.insert(0, os.path.join(os.getcwd(), "backend")); os.environ.setdefault("DJANGO_SETTINGS_MODULE", "trashtrotreasure.settings"); import django; django.setup()
ignore = migrations

[MESSAGES CONTROL]
disable = E0401, E1101

[FORMAT]
max-line-length = 120

[REPORTS]
score = no
output-format = text
[MASTER]
# Use pylint_django so pylint understands Django model attributes.
load-plugins = pylint_django

# Allow pylint to import Django settings and apps by adding the backend
# package to sys.path and calling django.setup(). This enables correct
# model/member detection for Django ORM attributes in many cases.
init-hook = import sys, os; sys.path.insert(0, os.path.join(os.getcwd(), "backend")); os.environ.setdefault("DJANGO_SETTINGS_MODULE", "trashtrotreasure.settings"); import django; django.setup()

# Don't lint migration files.
ignore = migrations

[MESSAGES CONTROL]
# Temporarily suppress Django dynamic-attribute false-positives (E1101)
# and import errors that happen in test contexts (E0401). Prefer targeted
# inline disables later for any remaining false positives.

    E1101,
# model/member detection for Django ORM attributes in many cases.
# and import errors that happen in test contexts (E0401). Prefer targeted
[MASTER]
# Minimal pylint config (single MASTER section) for this repository.
# Load pylint-django and initialize Django so pylint can resolve ORM
# attributes. Keep message suppression minimal (E0401/E1101) as an
# interim measure; prefer targeted inline disables for remaining cases.
load-plugins = pylint_django
init-hook = import sys, os; sys.path.insert(0, os.path.join(os.getcwd(), "backend")); os.environ.setdefault("DJANGO_SETTINGS_MODULE", "trashtrotreasure.settings"); import django; django.setup()
ignore = migrations

[MESSAGES CONTROL]
disable =
    E0401,
    E1101

[FORMAT]
max-line-length = 120

[REPORTS]
score = no
output-format = text
load-plugins = pylint_django
