REACT_APP_API_WS_HOST=
REACT_APP_SOCKET_URL=
REACT_APP_DEBUG_SOCKETS=false
REACT_APP_DEBUG_WS=false
REACT_APP_VERBOSE_ROUTER=false
# Pin the frontend dev server port to avoid port churn (optional)
PORT=3001
REACT_APP_API_URL=http://127.0.0.1:8001
# Disable automatic Socket.IO connection in local development; the app will
# fall back to polling for updates. Uncomment and set if you run a socket
# server at the backend during development.
REACT_APP_SOCKET_URL=
